# Postgres (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/avence?schema=public"

# WhatsApp Webhook
# Usado no GET verify (Meta challenge)
WHATSAPP_WEBHOOK_VERIFY_TOKEN="change-me"

# Usado no POST para validar X-Hub-Signature-256 (HMAC-SHA256 do corpo raw)
WHATSAPP_APP_SECRET="change-me"

# phone_number_id do número do Avence (quando disponível).
# Enquanto não tiver, deixe vazio e o roteamento cai em lookup no DB (PhoneNumberRoute) ou UNKNOWN.
AVENCE_PHONE_NUMBER_ID=""

# Endpoint admin (somente dev) para semear PhoneNumberRoute.
# Enviar no header: x-admin-seed-token
ADMIN_SEED_TOKEN="change-me"

# Token para endpoints "tool-like" (MCP) — B2B
MCP_B2B_TOKEN="change-me"


