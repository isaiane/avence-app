# Postgres (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/avence?schema=public"

# WhatsApp Webhook
# Usado no GET verify (Meta challenge)
WHATSAPP_WEBHOOK_VERIFY_TOKEN="change-me"

# Usado no POST para validar X-Hub-Signature-256 (HMAC-SHA256 do corpo raw)
WHATSAPP_APP_SECRET="change-me"

# WhatsApp Cloud API (envio de mensagens)
# Token de acesso (System User / Permanent token) com permissão de enviar mensagens
WHATSAPP_ACCESS_TOKEN=""
# Versão da Graph API (ex.: v21.0). Se vazio, usa v21.0.
WHATSAPP_API_VERSION="v21.0"

# (Opcional) Flow default (para b2b.send_flow, se você não passar flowId no tool call)
WHATSAPP_DEFAULT_FLOW_ID=""

# (Opcional) Flow específico para seleção de plano (Moment 4)
WHATSAPP_PLAN_FLOW_ID=""

# Checkout/webview (Moment 4)
AVENCE_CHECKOUT_URL_BASE=""

# phone_number_id do número do Avence (quando disponível).
# Enquanto não tiver, deixe vazio e o roteamento cai em lookup no DB (PhoneNumberRoute) ou UNKNOWN.
AVENCE_PHONE_NUMBER_ID=""

# Endpoint admin (somente dev) para semear PhoneNumberRoute.
# Enviar no header: x-admin-seed-token
ADMIN_SEED_TOKEN="change-me"

# Token para endpoints "tool-like" (MCP) — B2B
MCP_B2B_TOKEN="change-me"

# Agent runtime (B2B)
# - stub: comportamento atual (sem OpenAI)
# - agentkit: integra com OpenAI Agent Kit (quando configurado)
B2B_AGENT_RUNTIME="stub"

# OpenAI (quando B2B_AGENT_RUNTIME=agentkit)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"

# Nome do pacote/módulo do Agent Kit a ser importado (ex.: "@openai/agents", dependendo da distribuição)
OPENAI_AGENT_KIT_MODULE=""

# Token para consumir Agent Jobs (orquestrador externo: n8n / Agent Kit / worker)
# Enviar no header: x-agent-jobs-token
AGENT_JOBS_TOKEN="change-me"

# MCP Server adapter (para ChatKit "Connect to MCP Server")
# ChatKit envia esse token como Authorization/API key (depende do cliente).
MCP_SERVER_TOKEN="change-me"
MCP_SERVER_PORT="3333"

# Base URL do backend Next que o MCP adapter vai chamar via HTTP
MCP_ADAPTER_BACKEND_URL="http://localhost:3000"


