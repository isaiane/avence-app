{
  "name": "Avence B2B Worker (v0) — AgentJobs -> MCP (no ChatKit)",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": [
          {
            "mode": "everyMinute"
          }
        ]
      },
      "id": "Cron",
