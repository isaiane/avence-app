      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [240, 280]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.AVENCE_BACKEND_URL + \"/api/agent-jobs/b2b/next?lockedBy=\" + encodeURIComponent($env.N8N_WORKER_ID || \"n8n-dev\")}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
