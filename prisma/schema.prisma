generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Domain {
  B2B
  B2C
}

enum Plan {
  START
  PRO
  PAY
}

enum B2BConversationState {
  ONBOARDING
  MANAGEMENT
  SUPPORT
  FALLBACK
}

enum B2BStage {
  SALES_RECEPTION
  SALES_DIAGNOSIS
  ONBOARDING_ASSISTED
  ONBOARDING_COMPLETED
  PLAN_SELECTION
  WAITING
  HANDOFF_HUMAN
}

enum AgentJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum OutboundMessageStatus {
  PENDING
  SENT
  FAILED
}

model Business {
  id        String   @id @default(uuid())
  name      String?
  plan      Plan     @default(START)
  createdAt DateTime @default(now()) @map("created_at")

  phoneRoutes  PhoneNumberRoute[]
  contacts     MeiContact[]
  services     Service[]
  availability AvailabilityRule[]

  @@map("business")
}

model MeiContact {
  id          String   @id @default(uuid())
  waId        String   @unique @map("wa_id")
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])

  @@map("mei_contact")
}

model PhoneNumberRoute {
  id            String   @id @default(uuid())
  phoneNumberId String   @unique @map("phone_number_id")
  domain        Domain
  businessId    String?  @map("business_id")
  createdAt     DateTime @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id])

  @@map("phone_number_route")
}

model Service {
  id          String   @id @default(uuid())
  name        String
  priceCents  Int?     @map("price_cents")
  durationMin Int?     @map("duration_min")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, name])
  @@map("service")
}

model AvailabilityRule {
  id        String   @id @default(uuid())
  weekday   Int // 0=Sunday ... 6=Saturday
  startMin  Int      @map("start_min") // minutes from 00:00
  endMin    Int      @map("end_min")
  createdAt DateTime @default(now()) @map("created_at")

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId, weekday])
  @@map("availability_rule")
}

model Conversation {
  id            String                @id @default(uuid())
  domain        Domain
  stateB2B      B2BConversationState? @map("state_b2b")
  stageB2B      B2BStage              @default(SALES_RECEPTION) @map("stage_b2b")
  businessId    String?               @map("business_id")
  phoneNumberId String?               @map("phone_number_id")
  fromWaId      String?               @map("from_wa_id")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@map("conversation")
}

model InboundMessage {
  id                String   @id @default(uuid())
  providerMessageId String   @unique @map("provider_message_id")
  phoneNumberId     String   @map("phone_number_id")
  fromWaId          String?  @map("from_wa_id")
  messageType       String?  @map("message_type")
  textBody          String?  @map("text_body")
  providerTimestamp String?  @map("provider_timestamp")
  payload           Json
  receivedAt        DateTime @default(now()) @map("received_at")

  @@map("inbound_message")
}

model AuditEvent {
  id             String   @id @default(uuid())
  eventType      String   @map("event_type")
  domain         String
  businessId     String?  @map("business_id")
  phoneNumberId  String?  @map("phone_number_id")
  conversationId String?  @map("conversation_id")
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("audit_event")
}

model AgentJob {
  id              String         @id @default(uuid())
  domain          Domain
  kind            String
  status          AgentJobStatus @default(PENDING)
  providerMessageId String?      @unique @map("provider_message_id")
  phoneNumberId   String         @map("phone_number_id")
  conversationId  String         @map("conversation_id")
  fromWaId        String         @map("from_wa_id")
  payload         Json
  attempts        Int            @default(0)
  lockedAt        DateTime?      @map("locked_at")
  lockedBy        String?        @map("locked_by")
  lastError       String?        @map("last_error")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([domain, status, createdAt])
  @@map("agent_job")
}

model OutboundMessage {
  id             String                @id @default(uuid())
  domain         Domain
  status         OutboundMessageStatus @default(PENDING)
  idempotencyKey String                @unique @map("idempotency_key")
  providerMessageId String?            @map("provider_message_id")
  businessId     String?               @map("business_id")
  phoneNumberId  String?               @map("phone_number_id")
  conversationId String?               @map("conversation_id")
  toWaId         String                @map("to_wa_id")
  text           String
  error          String?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@index([domain, status, createdAt])
  @@map("outbound_message")
}
